<!--pages/admin/admin.wxml-->
<view class="container">
  <block wx:if="{{isLoading}}">
    <view class="loading-box">
      <view class="loading-text">正在校验权限...</view>
    </view>
  </block>

  <block wx:elif="{{!isSuperAdmin}}">
    <view class="error-box">
      <image class="error-icon" src="/images/kuji-door.svg" mode="aspectFit" />
      <view class="error-title">无权限访问</view>
      <view class="error-desc">该页面仅对超级管理员开放</view>
      <button class="back-btn" bindtap="goBack">返回首页</button>
    </view>
  </block>

  <block wx:else>
    <!-- Tab 切换 -->
    <view class="tab-bar">
      <view
        class="tab-item {{currentTab === 'users' ? 'active' : ''}}"
        data-tab="users"
        bindtap="switchTab"
      >用户管理</view>
      <view
        class="tab-item {{currentTab === 'logs' ? 'active' : ''}}"
        data-tab="logs"
        bindtap="switchTab"
      >操作日志</view>
      <view
        class="tab-item {{currentTab === 'tokens' ? 'active' : ''}}"
        data-tab="tokens"
        bindtap="switchTab"
      >临时链接</view>
    </view>

    <!-- 用户管理 -->
    <view wx:if="{{currentTab === 'users'}}" class="panel">
      <view class="panel-header">
        <view class="panel-title">授权用户</view>
        <view class="add-btn" bindtap="showAddUserModal">+ 新增</view>
      </view>

      <view wx:if="{{users.length === 0}}" class="empty-tip">暂无授权用户</view>

      <view wx:for="{{users}}" wx:key="_id" class="card user-card">
        <view class="card-row">
          <view class="user-name">{{item.nickname || '未命名'}}</view>
          <view class="role-tag role-{{item.role}}">{{item.role}}</view>
        </view>
        <view class="card-row secondary">
          <view class="openid">openid: {{item.openid}}</view>
        </view>
        <view class="card-row secondary">
          <view>创建时间：{{item.createTimeText}}</view>
        </view>
        <view class="card-row secondary">
          <view>最近活跃：{{item.lastSeenText || '从未'}}</view>
        </view>
        <view class="card-actions">
          <view class="action-text edit" data-id="{{item._id}}" bindtap="showEditUserModal">编辑</view>
          <view class="action-text delete" data-id="{{item._id}}" bindtap="deleteUser">删除</view>
        </view>
      </view>
    </view>

    <!-- 操作日志 -->
    <view wx:if="{{currentTab === 'logs'}}" class="panel">
      <view class="panel-header">
        <view class="panel-title">开关门记录</view>
        <view class="refresh-btn" bindtap="loadLogs">刷新</view>
      </view>

      <view wx:if="{{logs.length === 0}}" class="empty-tip">暂无操作记录</view>

      <view wx:for="{{logs}}" wx:key="_id" class="card log-card">
        <view class="card-row">
          <view class="log-action {{item.action}}">{{item.actionName}}</view>
          <view class="log-result {{item.result}}">{{item.result === 'success' ? '成功' : '失败'}}</view>
        </view>
        <view class="card-row secondary">
          <view>操作人：{{item.nickname}}（{{item.operatorType === 'temp' ? '临时访客' : '授权用户'}}）</view>
        </view>
        <view wx:if="{{item.tempToken}}" class="card-row secondary">
          <view>临时令牌：{{item.tempToken}}</view>
        </view>
        <view class="card-row secondary">
          <view>{{item.createTimeText}}</view>
        </view>
      </view>
    </view>

    <!-- 临时链接 -->
    <view wx:if="{{currentTab === 'tokens'}}" class="panel">
      <view class="panel-header">
        <view class="panel-title">临时分享链接</view>
        <view class="refresh-btn" bindtap="loadTokens">刷新</view>
      </view>

      <view wx:if="{{tokens.length === 0}}" class="empty-tip">暂无临时链接</view>

      <view wx:for="{{tokens}}" wx:key="_id" class="card token-card">
        <view class="card-row">
          <view class="token-code">{{item.token}}</view>
          <view class="token-status status-{{item.status}} {{item.used ? 'used' : ''}}">
            {{item.statusText}}
          </view>
        </view>
        <view class="card-row secondary">
          <view>创建人：{{item.creatorName}}</view>
        </view>
        <view class="card-row secondary">
          <view>创建：{{item.createTimeText}}</view>
        </view>
        <view class="card-row secondary">
          <view>过期：{{item.expireTimeText}}</view>
        </view>
        <view wx:if="{{item.usedTimeText}}" class="card-row secondary">
          <view>使用时间：{{item.usedTimeText}}</view>
        </view>
      </view>
    </view>

    <!-- 用户表单弹窗 -->
    <view wx:if="{{showUserModal}}" class="modal-mask" bindtap="hideUserModal">
      <view class="modal-content" catchtap="stopPropagation">
        <view class="modal-title">{{modalMode === 'add' ? '新增用户' : '编辑用户'}}</view>

        <view class="form-item">
          <view class="form-label">昵称</view>
          <input
            class="form-input"
            data-field="nickname"
            value="{{userForm.nickname}}"
            placeholder="请输入昵称"
            bindinput="onUserFormInput"
          />
        </view>

        <view class="form-item">
          <view class="form-label">角色</view>
          <picker mode="selector" range="{{roleOptions}}" range-key="label" bindchange="onRoleChange">
            <view class="form-picker">
              {{roleOptions[roleIndex].label}}
            </view>
          </picker>
        </view>

        <view wx:if="{{modalMode === 'add'}}" class="form-item">
          <view class="form-label">OpenID</view>
          <input
            class="form-input"
            data-field="openid"
            value="{{userForm.openid}}"
            placeholder="请输入用户 openid"
            bindinput="onUserFormInput"
          />
        </view>

        <view class="modal-actions">
          <button class="modal-btn cancel" bindtap="hideUserModal">取消</button>
          <button class="modal-btn confirm" bindtap="submitUserForm">保存</button>
        </view>
      </view>
    </view>
  </block>
</view>
