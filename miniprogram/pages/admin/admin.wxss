/* pages/admin/admin.wxss */
page {
  background-color: #F7F6F3;
}

.container {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 加载/错误状态 */
.loading-box,
.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #999;
}

.error-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.4;
  margin-bottom: 40rpx;
}

.error-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #37352F;
  margin-bottom: 16rpx;
}

.error-desc {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.back-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #37352F;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.back-btn::after {
  border: none;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #E9E9E7;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #999;
  position: relative;
  transition: color 0.2s;
}

.tab-item.active {
  color: #37352F;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #37352F;
  border-radius: 2rpx;
}

/* 面板 */
.panel {
  padding: 24rpx;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #37352F;
}

.add-btn,
.refresh-btn {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.add-btn {
  background: #37352F;
  color: #fff;
}

.refresh-btn {
  background: #fff;
  color: #37352F;
  border: 1rpx solid #E9E9E7;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 30rpx;
  color: #999;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-row:last-child {
  margin-bottom: 0;
}

.card-row.secondary {
  font-size: 26rpx;
  color: #999;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #37352F;
}

.openid {
  font-family: monospace;
  word-break: break-all;
}

.role-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.role-user {
  background: #E8F4E8;
  color: #2E7D32;
}

.role-admin {
  background: #FFF3E0;
  color: #EF6C00;
}

.role-super_admin {
  background: #FCE4EC;
  color: #C2185B;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-text {
  font-size: 28rpx;
  font-weight: 500;
}

.action-text.edit {
  color: #1976D2;
}

.action-text.delete {
  color: #D32F2F;
}

/* 日志 */
.log-action {
  font-size: 32rpx;
  font-weight: 600;
}

.log-action.open {
  color: #2E7D32;
}

.log-action.close {
  color: #D32F2F;
}

.log-result {
  font-size: 26rpx;
  font-weight: 500;
}

.log-result.success {
  color: #2E7D32;
}

.log-result.fail {
  color: #D32F2F;
}

/* 临时链接 */
.token-code {
  font-family: monospace;
  font-size: 30rpx;
  font-weight: 600;
  color: #37352F;
  word-break: break-all;
  flex: 1;
  margin-right: 16rpx;
}

.token-status {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.status-active {
  background: #E8F4E8;
  color: #2E7D32;
}

.status-expired,
.status-used {
  background: #F5F5F5;
  color: #999;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #37352F;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input,
.form-picker {
  height: 88rpx;
  background: #F7F6F3;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #37352F;
  line-height: 88rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #F0F0F0;
  color: #666;
}

.modal-btn.confirm {
  background: #37352F;
  color: #fff;
}

/* 通知公告 */
.form-textarea {
  width: 100%;
  height: 180rpx;
  background: #F7F6F3;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #37352F;
  box-sizing: border-box;
}

.notice-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.notice-switch-label {
  font-size: 28rpx;
  color: #666;
}

.notice-save-btn {
  width: 100%;
  margin-top: 8rpx;
}

.notice-tip {
  font-size: 26rpx;
  color: #999;
  padding: 0 8rpx;
  line-height: 1.6;
}
